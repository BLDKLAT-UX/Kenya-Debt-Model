# Kenya Debt Model — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# API key (if using live data integration or AI chat features)
API_KEY=your_api_key_here

# Optional: override config file location
# CONFIG_PATH=config/assumptions.yaml

# Optional: force terminal colour output even when not in a TTY
# FORCE_COLOR=1

# Optional: set log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
